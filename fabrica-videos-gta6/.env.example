# ---- Claude (guiones). Obligatorio. ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-opus-5-5

# ---- Canal ----
TEMA=GTA 6
IDIOMA=es
PAISES=MX,US,ES,AR,CO
VIDEOS_POR_DIA=3
# Formatos por video del día, en orden: short (9:16, <60 s) o largo (16:9, 6-9 min)
FORMATOS=short,short,largo

# ---- Voz (edge-tts, gratis). Ver README para instalarlo. ----
VOZ=es-MX-JorgeNeural
VOZ_VELOCIDAD=+8%
PYTHON_TTS=./.venv-tts/bin/python3

# ---- YouTube (npm run youtube:auth genera el refresh token) ----
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
# private | unlisted | public  (con public se programan a las horas de YT_HORAS)
YT_PRIVACIDAD=private
YT_HORAS=12:00,17:00,21:00
TZ_PUBLICACION=America/Mexico_City

# ---- TikTok (Content Posting API). Sin auditoría solo publica en privado. ----
TIKTOK_ACCESS_TOKEN=
TIKTOK_PRIVACIDAD=SELF_ONLY
